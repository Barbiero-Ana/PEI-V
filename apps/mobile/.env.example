# Copie para .env.local. Variáveis EXPO_PUBLIC_ são incluídas no app e não podem conter segredos.
# "auto" é apenas para API e Metro no mesmo computador, acessíveis pela rede local.
EXPO_PUBLIC_API_URL=auto
# Para APK distribuído, configure uma URL HTTPS real no ambiente EAS correspondente.
# EXPO_PUBLIC_API_URL=https://api.modolume.com.br
