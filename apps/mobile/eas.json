{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "environment": "preview",
      "env": { "EXPO_PUBLIC_APP_ENV": "homologacao" },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "22.14.0"
    },
    "production": {
      "environment": "production",
      "env": { "EXPO_PUBLIC_APP_ENV": "producao" },
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "play-internal": {
      "env": { "EXPO_PUBLIC_APP_ENV": "homologacao" },
      "extends": "production",
      "environment": "preview"
    }
  }
}
