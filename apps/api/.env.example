# Copie para .env e preencha.
# API: usuário com privilégio mínimo (prisma/sql/papel-da-api.sql). No banco local, pode ser o mesmo do DIRECT_URL.
DATABASE_URL="postgresql://modolume_api:SENHA@HOST:PORTA/BANCO"
# Migrações (prisma migrate deploy): usuário administrador.
DIRECT_URL="postgresql://postgres:SENHA@HOST:PORTA/BANCO"
JWT_SEGREDO="um-segredo-longo-e-aleatorio"
PORTA=3333
ORIGENS="http://localhost:3000"
SENHA_DEMO="modolume2026"
