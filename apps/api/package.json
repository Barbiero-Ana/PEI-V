{
  "name": "@modolume/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API do Modolume: liga o app do aluno ao painel do professor (NestJS + Prisma + PostgreSQL).",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "tsx src/main.ts",
    "banco:local": "tsx scripts/banco-local.ts",
    "homologacao:preparar": "tsx scripts/preparar-homologacao.ts",
    "test:banco": "tsx scripts/verificar-banco.ts",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "lint": "eslint src scripts prisma/seed.ts",
    "db:migrar": "prisma migrate deploy",
    "db:nova-migracao": "prisma migrate dev --create-only"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@modolume/core": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/parser": "8.71.1",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.5",
    "prisma": "^6.19.3",
    "typescript": "^5.7.3"
  }
}
